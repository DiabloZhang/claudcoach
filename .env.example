# Strava API
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret
STRAVA_REDIRECT_URI=http://localhost:8000/strava/callback

# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key
GEMINI_API_KEY=your_gemini_api_key
LLM_PROVIDER=gemini

# Database (SQLite for local dev, PostgreSQL for Railway)
DATABASE_URL=sqlite:///./tricoach.db
# DATABASE_URL=postgresql://user:password@localhost/tricoach

# App
SECRET_KEY=change_this_to_a_random_secret_at_least_32_chars_long
FRONTEND_URL=http://localhost:3000

# Polling
POLL_INTERVAL_MINUTES=60

# JWT (optional, defaults shown)
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
